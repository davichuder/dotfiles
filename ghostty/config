# --- tipografía ---
font-family = "MesloLGS Nerd Font"
font-family = "FiraCode Nerd Font"
font-size = 12

# tamaño inicial (en celdas: columnas x filas)
window-width = 250
window-height = 60

# --- tema ---
theme = Night Owl

# --- tabs y splits: los gestiona herdr ---
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+s=unbind

# Server-side decorations: the compositor draws the titlebar instead of GTK.
# Works around the WSLg "maximized borderless window is offset" bug.
window-decoration = server

# --- herdr por defecto ---
command = herdr

