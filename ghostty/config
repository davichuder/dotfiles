# --- tipografía ---
font-family = "MesloLGS Nerd Font"
font-family = "FiraCode Nerd Font"
font-size = 12

# tamaño inicial (cols x ?)
window-width = 800
window-height = 600

# --- tema ---
theme = Night Owl

# --- tabs y splits: los gestiona herdr ---
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+s=unbind

# keep UI decorations (title bar), only unbind tab/split keys
window-decoration = auto

# --- herdr por defecto ---
command = herdr

