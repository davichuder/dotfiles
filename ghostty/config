# --- tipografía ---
font-family = "MesloLGS Nerd Font"
font-family = "FiraCode Nerd Font"
font-size = 12

# tamaño inicial (en celdas: columnas x filas)
window-width = 250
window-height = 60

# --- tema ---
theme = Night Owl

# --- tabs y splits: los gestiona herdr ---
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+s=unbind

# Native decorations (compositor-chosen). WSLg's maximize offset is fixed in
# WSL >= 2.6.x; if it ever comes back, switch this to `server`.
window-decoration = auto

# --- herdr por defecto ---
command = herdr

# X11/WSL: force clipboard flush on paste
keybind = ctrl+v=paste_from_clipboard
