# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Runtimes (node, java, rust) come from mise; no fnm/sdkman/rustup env here.

# powerlevel10k prompt (theme + user config)
source "/home/linuxbrew/.linuxbrew/opt/powerlevel10k/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Correccion de bug de alacritty en wsl2
alias alacritty="WINIT_UNIX_BACKEND=x11 alacritty"

# Shell integrations (lines managed by `mise dot`; keep them exactly as declared)
source <(fzf --zsh)
eval "$(zoxide init zsh)"
export CARAPACE_BRIDGES='zsh,fish,bash'
autoload -Uz compinit; compinit -C; source <(carapace _carapace)
eval "$(atuin init zsh)"
eval "$(navi widget zsh)"
source "/home/linuxbrew/.linuxbrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
# zsh-syntax-highlighting must remain last of the ZLE plugins
source "/home/linuxbrew/.linuxbrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# >>> mise:activate >>> managed by mise — do not edit between markers
eval "$(mise activate zsh)"
# <<< mise:activate <<<
_pr_stub() { (( ${+_PR_LOADED} )) || { typeset -g _PR_LOADED=1; eval "$(pay-respects zsh)"; }; f "$@"; }; unalias f 2>/dev/null; alias f=_pr_stub; command_not_found_handler() { (( ${+_PR_LOADED} )) || { typeset -g _PR_LOADED=1; eval "$(pay-respects zsh)"; }; command_not_found_handler "$@"; }
alias fuck=f
unalias f 2>/dev/null; unfunction f 2>/dev/null; _pr_stub() { (( ${+_PR_LOADED} )) || { typeset -g _PR_LOADED=1; eval "$(pay-respects zsh)"; }; f "$@"; }; unalias f 2>/dev/null; alias f=_pr_stub; command_not_found_handler() { (( ${+_PR_LOADED} )) || { typeset -g _PR_LOADED=1; eval "$(pay-respects zsh)"; }; command_not_found_handler "$@"; }

alias lg='lazygit'


# fzf
export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git --exclude node_modules"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git --exclude node_modules"
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --color='border:240,fg:-1,preview-bg:-1,prompt:214,pointer:214,marker:46' --info=inline --prompt='> ' --border-label=' fzf ' --preview 'bat --color=always --style=numbers --line-range :300 {}'"

# eza
export EZA_COLORS="di=32:ln=33:so=35:pi=33:ex=31:bd=33:cd=33:su=37:sg=37:tw=32:ow=33"
alias ls="eza --icons=auto --group-directories-first --color=auto"
alias ll="eza -lah --git --icons=auto --group-directories-first"
alias tree="eza --tree --level=3 --icons=auto --group-directories-first"

# dua: date/mtime is still via interactive key M; aliases preserve quick access
alias duai="dua interactive"

# jq/yq
export JQ_COLORS="1;30:0;31:0;32:0;36:0;33:1;35:1;35:1;36"
alias yq="yq --colors --prettyPrint"
